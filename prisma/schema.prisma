// Paisaa — Personal Finance Tracker
// Replace the entire contents of prisma/schema.prisma with this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// NextAuth.js models (required names — do not rename)
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts      Account[]        // OAuth accounts (NextAuth)
  sessions      Session[]

  // App relations
  moneyAccounts  MoneyAccount[]
  categories     Category[]
  transactions   Transaction[]
  budgets        Budget[]
  recurringRules RecurringRule[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// Paisaa app models
// ─────────────────────────────────────────────

enum MoneyAccountType {
  BANK
  CREDIT_CARD
  UPI_WALLET
  CASH
  LOAN
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionDirection {
  IN
  OUT
}

enum PaymentMethod {
  UPI
  AUTO_DEBIT
  NEFT
  CARD
  CASH
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurringKind {
  EXPENSE
  INVESTMENT
}

// "Accounts" from the spec — named MoneyAccount to avoid
// colliding with NextAuth's required Account model.
model MoneyAccount {
  id        String           @id @default(cuid())
  userId    String
  name      String           // "HDFC Savings"
  type      MoneyAccountType
  last4     String?          // "2841"
  color     String?          // hex token, e.g. "#0F6B4F"
  createdAt DateTime         @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  recurringRules RecurringRule[]

  @@index([userId])
  @@unique([userId, name]) 
}

model Category {
  id        String       @id @default(cuid())
  userId    String
  name      String       // "Groceries & Food"
  emoji     String?      // "🍛"
  color     String?
  type      CategoryType
  isDefault Boolean      @default(false) // seeded on first login
  createdAt DateTime     @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  budgets        Budget[]
  recurringRules RecurringRule[]

  @@unique([userId, name, type])
  @@index([userId])
}

model Transaction {
  id             String               @id @default(cuid())
  userId         String
  moneyAccountId String
  categoryId     String
  amount         Decimal              @db.Decimal(12, 2) // always positive; direction gives the sign
  direction      TransactionDirection
  date           DateTime
  description    String               // merchant / note, e.g. "Big Bazaar"
  paymentMethod  PaymentMethod
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  moneyAccount MoneyAccount @relation(fields: [moneyAccountId], references: [id], onDelete: Restrict)
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([userId, moneyAccountId])
}

// One budget per category; the monthly limit applies every month.
// Spent amount is computed from transactions at query time.
model Budget {
  id           String   @id @default(cuid())
  userId       String
  categoryId   String
  monthlyLimit Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([userId])
}

model RecurringRule {
  id             String             @id @default(cuid())
  userId         String
  moneyAccountId String
  categoryId     String
  name           String             // "Netflix", "Nifty 50 SIP"
  amount         Decimal            @db.Decimal(12, 2)
  frequency      RecurringFrequency
  nextRunDate    DateTime
  kind           RecurringKind
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  moneyAccount MoneyAccount @relation(fields: [moneyAccountId], references: [id], onDelete: Restrict)
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, nextRunDate])
}
